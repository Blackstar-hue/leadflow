generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ADMIN
  OPERATIONS
  RENTER
  VIEWER
}
enum AssetStatus {
  PENDING
  CONNECTED
  PAUSED
}
enum LeadStatus {
  NEW
  NEEDS_REVIEW
  QUALIFIED
  ASSIGNED
  CONTACTED
  WON
  LOST
  SPAM
}
enum Urgency {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}
enum LeadQuality {
  LOW
  MEDIUM
  HIGH
}
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}
enum EventType {
  RECEIVED
  CATEGORISED
  ROUTED
  ROUTING_FAILED
  ASSIGNED
  REASSIGNED
  STATUS_CHANGED
  NOTIFICATION_QUEUED
  NOTIFICATION_SENT
  NOTIFICATION_FAILED
  NOTE_ADDED
}

model Workspace {
  id String @id @default(cuid())
  name String
  slug String @unique
  createdAt DateTime @default(now())
  memberships Membership[]
  businesses Business[]
  websites Website[]
  gmbAssets GmbAsset[]
  leads Lead[]
  renters Renter[]
  routingRules RoutingRule[]
  notifications Notification[]
  calls CallRecord[]
  apiCredentials ApiCredential[]
  jobs ImportExportJob[]
  auditLogs AuditLog[]
  leadEvents LeadEvent[]
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now())
  memberships Membership[]
  auditLogs AuditLog[]
}

model Membership {
  id String @id @default(cuid())
  workspaceId String
  userId String
  role MembershipRole
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([userId])
}

model Business {
  id String @id @default(cuid())
  workspaceId String
  code String
  name String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  websites Website[]
  gmbAssets GmbAsset[]
  leads Lead[]
  @@unique([workspaceId, code])
  @@index([workspaceId, name])
}

model Website {
  id String @id @default(cuid())
  workspaceId String
  businessId String
  domain String
  status AssetStatus @default(PENDING)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  gmbAssets GmbAsset[]
  leads Lead[]
  @@unique([workspaceId, domain])
  @@index([workspaceId, businessId])
}

model GmbAsset {
  id String @id @default(cuid())
  workspaceId String
  businessId String
  websiteId String?
  assetId String
  name String
  phone String?
  status AssetStatus @default(PENDING)
  sourceKeyHash String?
  connectedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  website Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  leads Lead[]
  calls CallRecord[]
  apiCredentials ApiCredential[]
  @@unique([workspaceId, assetId])
  @@index([workspaceId, status])
}

model Renter {
  id String @id @default(cuid())
  workspaceId String
  name String
  company String?
  email String?
  phone String?
  categories String[]
  available Boolean @default(true)
  priority Int @default(0)
  active Boolean @default(true)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads Lead[]
  @@index([workspaceId, active, available, priority])
}

model Lead {
  id String @id @default(cuid())
  workspaceId String
  businessId String
  websiteId String?
  gmbAssetId String?
  assignedRenterId String?
  createdAt DateTime @default(now())
  receivedAt DateTime @default(now())
  websiteDomain String?
  gmbName String?
  sourceChannel String
  leadType String?
  name String
  phone String
  email String?
  postcodeArea String?
  city String?
  originalMessage String?
  serviceCategory String
  leadSummary String?
  urgency Urgency @default(NORMAL)
  leadQuality LeadQuality @default(MEDIUM)
  spamLikelihood Float @default(0)
  status LeadStatus @default(NEW)
  assignedAt DateTime?
  renterNotified Boolean @default(false)
  notificationStatus NotificationStatus @default(PENDING)
  outcome String?
  gclid String?
  gbraid String?
  wbraid String?
  utmSource String?
  utmMedium String?
  utmCampaign String?
  landingPage String?
  referrer String?
  consent Boolean?
  notes String?
  rawPayload Json?
  idempotencyKey String?
  messageFingerprint String?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  website Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  gmbAsset GmbAsset? @relation(fields: [gmbAssetId], references: [id], onDelete: SetNull)
  assignedRenter Renter? @relation(fields: [assignedRenterId], references: [id], onDelete: SetNull)
  events LeadEvent[]
  notifications Notification[]
  calls CallRecord[]
  @@index([workspaceId, status, receivedAt])
  @@index([workspaceId, assignedRenterId, receivedAt])
  @@index([workspaceId, websiteId, receivedAt])
  @@index([workspaceId, gmbAssetId, receivedAt])
  @@index([workspaceId, serviceCategory, receivedAt])
  @@index([workspaceId, phone, receivedAt])
  @@index([workspaceId, idempotencyKey])
}

model RoutingRule {
  id String @id @default(cuid())
  workspaceId String
  name String
  priority Int
  conditions Json
  renterId String?
  fallback Boolean @default(false)
  active Boolean @default(true)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, active, priority])
}

model LeadEvent {
  id String @id @default(cuid())
  workspaceId String
  leadId String
  type EventType
  actorId String?
  metadata Json?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([workspaceId, leadId, createdAt])
}

model Notification {
  id String @id @default(cuid())
  workspaceId String
  leadId String
  kind String
  recipient String
  status NotificationStatus @default(PENDING)
  attemptCount Int @default(0)
  lastError String?
  sentAt DateTime?
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status, createdAt])
}

model CallRecord {
  id String @id @default(cuid())
  workspaceId String
  leadId String? @unique
  gmbAssetId String?
  receivedAt DateTime @default(now())
  trackingNumber String?
  callerNumber String?
  durationSeconds Int?
  recordingUrl String?
  transcription String?
  serviceCategory String?
  assignedRenterId String?
  status String @default("New")
  outcome String?
  notes String?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  gmbAsset GmbAsset? @relation(fields: [gmbAssetId], references: [id], onDelete: SetNull)
  @@index([workspaceId, receivedAt])
}

model ApiCredential {
  id String @id @default(cuid())
  workspaceId String
  gmbAssetId String?
  label String
  keyHash String
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  gmbAsset GmbAsset? @relation(fields: [gmbAssetId], references: [id], onDelete: Cascade)
  @@index([workspaceId, revokedAt])
}

model ImportExportJob {
  id String @id @default(cuid())
  workspaceId String
  type String
  status String @default("Pending")
  rowCount Int @default(0)
  errorMessage String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  workspaceId String
  actorId String?
  action String
  entityType String
  entityId String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
}

model WebhookEvent {
  id String @id @default(cuid())
  provider String
  eventId String
  payload Json?
  createdAt DateTime @default(now())
  @@unique([provider, eventId])
  @@index([provider, createdAt])
}
